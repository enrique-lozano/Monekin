---- * WHEN CONVERTING TO .sql:
---- * --- Remove the 'AS ....' after a table creation  
---- * --- Convert DATETIME to TEXT, BOOL to INT and ENUMS to TEXT
---- * --- Remove the MAPPED BY to only leave the CHECK constraints
---- * --- Remove the imports 

import './../../../models/transaction/transaction.dart';
import './../../../models/transaction/transaction_status.enum.dart';
import './../../../models/transaction/transaction_type.enum.dart';
import './../../../models/date-utils/periodicity.dart';
import './../../../models/category/category.dart';
import './../../../models/account/account.dart';
import './../../../models/asset/asset_type.enum.dart';
import './../../../models/asset/security_type.enum.dart';
import './../../../models/goal/goal.dart';
import './../../../models/goal/goal_type.enum.dart';
import './../../../models/debt/debt_direction.enum.dart';
import './../../services/user-setting/user_setting_service.dart';
import './../../services/app-data/app_data_service.dart';
import './../../utils/database_enum.dart';
import './../../utils/converters/list_converters.dart';
import './../../utils/converters/custom_enum_converter.dart';
import './../../utils/converters/date_converters.dart';

CREATE TABLE IF NOT EXISTS currencies (
    -- ISO 4217 currency code. Identifies a currency uniquely ([see more](https://en.wikipedia.org/wiki/ISO_4217#List_of_ISO_4217_currency_codes))
    code TEXT NOT NULL PRIMARY KEY,

    -- Symbol to represent the currency
    symbol TEXT NOT NULL,

    -- Name of the currency (in the user language at database creation)
    name TEXT NOT NULL,

    -- Number of decimal places used by this currency
    decimalPlaces INTEGER NOT NULL,

    -- Whether this currency is one of the default currencies of the app
    isDefault BOOLEAN NOT NULL,

    -- Type of currency:
    -- 0 = fiat
    -- 1 = crypto
    -- 2 = other
    type INTEGER NOT NULL
) AS CurrencyInDB;

CREATE TABLE IF NOT EXISTS exchangeRates (
    id TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL MAPPED BY `const DateTypeConverter()`,
    currencyCode TEXT NOT NULL REFERENCES currencies(code) ON DELETE CASCADE ON UPDATE CASCADE,
    exchangeRate REAL NOT NULL
) AS ExchangeRateInDB;

CREATE UNIQUE INDEX idx_exchangeRates_currencyCode_date
ON exchangeRates(currencyCode, date DESC);

CREATE TABLE IF NOT EXISTS accounts (
    id TEXT NOT NULL PRIMARY KEY,
    
    -- Account name (unique among user accounts)
    name TEXT UNIQUE NOT NULL,

    -- Free-text group. Accounts sharing the exact same value are displayed
    -- together (as a single expandable row) in the account lists and stats.
    groupName TEXT,

    
    iniValue REAL NOT NULL,

    -- Creation/Opening date of this account. Before this date, no transactions can exists on it.
    date DATETIME NOT NULL,

    description TEXT,

    -- The type of the account. 'money' (cash only) or 'investment' (cash + holdings)
    type ENUMNAME(AccountType) NOT NULL CHECK(type IN ('money', 'investment')),

    -- Whether this money account behaves as a savings account (money only in/out via transfers)
    isSaving BOOLEAN NOT NULL DEFAULT 0,

    -- Only meaningful for investment accounts. 'transactions': positions are
    -- derived from buy/sell trades (type 'N'). 'holdings': positions are entered
    -- as manual snapshots (quantity + avg cost) by date, no trades allowed.
    trackingMode ENUMNAME(AccountTrackingMode) NOT NULL DEFAULT 'transactions' CHECK(trackingMode IN ('transactions', 'holdings')),
    
    iconId TEXT NOT NULL,

    -- The display order when listing accounts
    displayOrder INTEGER NOT NULL,

    -- If null, an automatic color will be applied
    color TEXT,

    -- The closing date of the account. After this date, no transactions can exists on it.
    closingDate DATETIME,

    -- ID of the currency used by this account and therefore all transactions contained in it
    currencyId TEXT NOT NULL REFERENCES currencies(code) ON DELETE CASCADE ON UPDATE CASCADE,
    
    iban TEXT,
    swift TEXT
) AS AccountInDB;

CREATE TABLE IF NOT EXISTS categories (
    id TEXT NOT NULL PRIMARY KEY,

    -- The name of the category
    name TEXT UNIQUE NOT NULL,

    -- Id of the icon that represents this category
    iconId TEXT NOT NULL,

    -- Color that will be used to represent this category in some screens. If null, the color of the parent's category will be used
    color TEXT,

    -- The display order when listing categories
    displayOrder INTEGER NOT NULL,

    -- Type of the category. If null, the type of the parent's category will be used
    type ENUMNAME(CategoryType) CHECK(type IN ('E', 'I', 'B')),

    -- Parent category of this category (if any)
    parentCategoryID TEXT REFERENCES categories(id) ON DELETE CASCADE ON UPDATE CASCADE,

    --- Color and type are not needed in child categories. They are inherited from the parent 
    CHECK ((parentCategoryID IS NULL) != (color IS NULL AND type IS NULL)),
    CHECK ((color IS NULL) == (type IS NULL))
) AS CategoryInDB;

CREATE TABLE IF NOT EXISTS assets (
    id TEXT NOT NULL PRIMARY KEY,

    -- Asset name (unique among user assets)
    name TEXT UNIQUE NOT NULL,

    -- Optional description
    description TEXT,

    -- ID of the reference currency for this asset
    currencyId TEXT NOT NULL REFERENCES currencies(code) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Initial/purchase value of the asset
    initialValue REAL NOT NULL DEFAULT 0,

    -- Date this asset was acquired or created
    creationDate DATETIME NOT NULL,

    assetType TEXT NOT NULL DEFAULT 'other' CHECK(assetType IN ('real_estate', 'vehicle', 'precious_metal', 'jewelry_art', 'other')) MAPPED BY `CustomEnumConverter(AssetType.values)`,

    -- Optional liability (e.g. a mortgage) linked to this physical asset
    linkedDebtId TEXT REFERENCES debts(id) ON DELETE SET NULL ON UPDATE CASCADE
) AS AssetInDB;

CREATE UNIQUE INDEX idx_valuations_assetId_date ON valuations(assetId, date DESC);

CREATE TABLE IF NOT EXISTS valuations (
    id TEXT NOT NULL PRIMARY KEY,

    -- ID of the asset this valuation belongs to (mutually exclusive with accountId)
    assetId TEXT NOT NULL REFERENCES assets(id) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Date of this valuation snapshot
    date TEXT NOT NULL MAPPED BY `const DateTypeConverter()`,

    -- Value at the time of this snapshot, in the currency of the account or asset
    value REAL NOT NULL,
) AS ValuationInDB;

-- A financial instrument (stock, fund, crypto) that can be held inside
-- investment accounts. The price is shared across all holdings of this security.
CREATE TABLE IF NOT EXISTS securities (
    id TEXT NOT NULL PRIMARY KEY,

    -- Display name (e.g. "Apple Inc.", "Vanguard FTSE All-World")
    name TEXT NOT NULL,

    -- The type of security: stock, fund or crypto
    type ENUMNAME(SecurityType) NOT NULL DEFAULT 'stock' CHECK(type IN ('stock', 'fund', 'crypto')),

    -- Reference/quote currency of this security
    currencyId TEXT NOT NULL REFERENCES currencies(code) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Optional ticker/symbol (e.g. AAPL, VWCE, BTC)
    ticker TEXT,

    -- Optional free-text notes/description about the security
    notes TEXT,

    -- Latest known price per unit, updated manually (offline-first)
    currentPrice REAL,

    -- Date of the latest price
    priceDate DATETIME,

    iconId TEXT,
    color TEXT
) AS SecurityInDB;

-- Manual price observations for a security over time, used to draw the real
-- price chart. A new row is recorded each time the price is updated. The most
-- recent point is mirrored into `securities.currentPrice`/`priceDate`.
CREATE TABLE IF NOT EXISTS securityPriceHistory (
    id TEXT NOT NULL PRIMARY KEY,

    securityID TEXT NOT NULL REFERENCES securities(id) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Date of this price observation
    date DATETIME NOT NULL,

    -- Price per unit at that date, in the security currency
    price REAL NOT NULL
) AS SecurityPriceHistoryInDB;

-- A user-configurable classification dimension used to categorize securities
-- for portfolio-composition reporting (e.g. Asset Class, Region, Sector, Risk).
-- Built-in taxonomies ship seeded (`isSystem = 1`) but remain fully editable.
CREATE TABLE IF NOT EXISTS taxonomies (
    id TEXT NOT NULL PRIMARY KEY,

    -- Display name of the taxonomy
    name TEXT NOT NULL,

    -- Accent color used in charts/legends
    color TEXT NOT NULL DEFAULT '#8abceb',

    description TEXT,

    -- Whether this taxonomy ships built-in with the app (vs user-created)
    isSystem BOOLEAN NOT NULL DEFAULT 0,

    -- When true, a security may be assigned to at most one category of this
    -- taxonomy (e.g. Risk). When false, a security can be split across several
    -- categories with weights (e.g. Regions).
    isSingleSelect BOOLEAN NOT NULL DEFAULT 0,

    -- The display order when listing taxonomies
    displayOrder INTEGER NOT NULL DEFAULT 0
) AS TaxonomyInDB;

-- One option inside a taxonomy. Categories may be hierarchical via parentID
-- (e.g. Region: Europe -> Northern Europe).
CREATE TABLE IF NOT EXISTS taxonomyCategories (
    id TEXT NOT NULL PRIMARY KEY,

    taxonomyID TEXT NOT NULL REFERENCES taxonomies(id) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Parent category within the same taxonomy (if any)
    parentID TEXT REFERENCES taxonomyCategories(id) ON DELETE CASCADE ON UPDATE CASCADE,

    name TEXT NOT NULL,

    -- Display color of this category in charts/legends
    color TEXT NOT NULL DEFAULT '#808080',

    description TEXT,

    -- The display order when listing categories inside their taxonomy
    displayOrder INTEGER NOT NULL DEFAULT 0
) AS TaxonomyCategoryInDB;

CREATE INDEX IF NOT EXISTS idx_taxonomyCategories_taxonomyID ON taxonomyCategories(taxonomyID);

-- Assigns a security to a taxonomy category with a weight in basis points
-- (0..10000, where 10000 = 100%). A security can be split across several
-- categories of a multi-select taxonomy (e.g. a world fund 60% US / 40% Europe).
CREATE TABLE IF NOT EXISTS securityTaxonomyAssignments (
    id TEXT NOT NULL PRIMARY KEY,

    securityID TEXT NOT NULL REFERENCES securities(id) ON DELETE CASCADE ON UPDATE CASCADE,
    taxonomyID TEXT NOT NULL REFERENCES taxonomies(id) ON DELETE CASCADE ON UPDATE CASCADE,
    categoryID TEXT NOT NULL REFERENCES taxonomyCategories(id) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Weight in basis points (10000 = 100%)
    weight INTEGER NOT NULL DEFAULT 10000 CHECK(weight >= 0 AND weight <= 10000),

    UNIQUE(securityID, taxonomyID, categoryID)
) AS SecurityTaxonomyAssignmentInDB;

CREATE INDEX IF NOT EXISTS idx_securityTaxonomyAssignments_securityID ON securityTaxonomyAssignments(securityID);
CREATE INDEX IF NOT EXISTS idx_securityTaxonomyAssignments_taxonomyID ON securityTaxonomyAssignments(taxonomyID);

-- A position of a given security inside a given account: how many units are held
-- and the weighted-average cost paid per unit.
CREATE TABLE IF NOT EXISTS holdings (
    id TEXT NOT NULL PRIMARY KEY,

    accountID TEXT NOT NULL REFERENCES accounts(id) ON DELETE CASCADE ON UPDATE CASCADE,
    securityID TEXT NOT NULL REFERENCES securities(id) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Number of units currently held
    quantity REAL NOT NULL DEFAULT 0,

    -- Weighted-average cost paid per unit, in the security currency
    avgCostPrice REAL NOT NULL DEFAULT 0,

    UNIQUE(accountID, securityID)
) AS HoldingInDB;

-- A portfolio snapshot: the complete state of an investment account's holdings
-- on a given date (used by accounts in 'holdings' tracking mode). Each snapshot
-- groups zero or more position rows (see `holdingSnapshots`); a snapshot with no
-- positions represents an empty portfolio on that date. When valuing the account
-- at a date, the most recent snapshot on or before that date defines the entire
-- set of holdings (securities absent from it are considered not held).
CREATE TABLE IF NOT EXISTS accountSnapshots (
    id TEXT NOT NULL PRIMARY KEY,

    accountID TEXT NOT NULL REFERENCES accounts(id) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Date of this portfolio snapshot (one snapshot per account per date)
    date DATETIME NOT NULL,

    UNIQUE(accountID, date)
) AS AccountSnapshotInDB;

-- A single position inside a portfolio snapshot: how many units of a security
-- were held and the weighted-average cost paid, as of the parent snapshot date.
CREATE TABLE IF NOT EXISTS holdingSnapshots (
    id TEXT NOT NULL PRIMARY KEY,

    snapshotID TEXT NOT NULL REFERENCES accountSnapshots(id) ON DELETE CASCADE ON UPDATE CASCADE,
    securityID TEXT NOT NULL REFERENCES securities(id) ON DELETE CASCADE ON UPDATE CASCADE,

    -- Number of units held at the snapshot date
    quantity REAL NOT NULL,

    -- Weighted-average cost paid per unit, in the security currency
    avgCostPrice REAL NOT NULL,

    UNIQUE(snapshotID, securityID)
) AS HoldingSnapshotInDB;

CREATE TABLE IF NOT EXISTS transactions (
  id TEXT NOT NULL PRIMARY KEY,
  
  -- Date on which the payment of this transaction was made
  date DATETIME NOT NULL,

  accountID TEXT NOT NULL REFERENCES accounts(id) ON DELETE CASCADE ON UPDATE CASCADE,
  
  -- Monetary amount related to this transaction, in the currency of its account
  value REAL NOT NULL,

  -- Title or main label of this transaction. If not defined, the category name is used normally as fallback
  title TEXT,

  -- Some description, notes or extra info about the transaction.
  notes TEXT,

  -- Income, expense, transfer, or investment (asset cash leg; excluded from I/E stats)
  type TEXT NOT NULL CHECK(type IN ('E', 'I', 'T', 'N')) MAPPED BY `CustomEnumConverter(TransactionType.values)`,

  -- Optional link to an asset (legacy buy/sell / investment flows)
  assetID TEXT REFERENCES assets(id) ON DELETE SET NULL ON UPDATE CASCADE,

  -- Optional link to a security (holdings buy/sell flows)
  securityID TEXT REFERENCES securities(id) ON DELETE SET NULL ON UPDATE CASCADE,

  -- For security trades: number of units bought (+) or sold (-)
  quantity REAL,

  -- For security trades: price paid/received per unit
  pricePerUnit REAL,
  
  status TEXT CHECK(status IN ('V', 'P', 'R', 'U')) MAPPED BY `CustomEnumConverter(TransactionStatus.values)`,
  categoryID TEXT REFERENCES categories(id) ON DELETE CASCADE ON UPDATE CASCADE,

  -- If this transaction is related to a debt, the ID of the debt. This field is independent of the account and category fields, so it can be used in transactions of different accounts and categories as long as they are related to the same debt. It will be null for transactions that are not related to any debt.
  debtId TEXT REFERENCES debts(id) ON DELETE SET NULL ON UPDATE CASCADE,

  -- In case this transaction is a transfer, the account that receives the transfer. Only one of categoryID or receivingAccountID can be defined, never both or none
  receivingAccountID TEXT REFERENCES accounts(id) ON DELETE CASCADE ON UPDATE CASCADE,

  -- In case this transaction is a transfer, the value that will be added to the receiving account. This value can be different from the `value` field if the transfer involves a currency exchange. It will always be in the currency of the receiving account.
  valueInDestiny REAL,

  isHidden BOOLEAN NOT NULL DEFAULT 0,

  ----------- Location data --------------

  -- Latitude of the location where the transaction occurred
  locLatitude REAL,

  -- Longitude of the location where the transaction occurred
  locLongitude REAL,

  -- Address, name or description of the location where the transaction occurred
  locAddress TEXT,

  ------------- Recurrency data ---------------

  -- The time range with which new transactions to be paid will appear (weekly, monthly...)
  intervalPeriod ENUMNAME(Periodicity) CHECK(intervalPeriod IN ('day','week','month','year')),

  -- Within the time range chosen in the `intervalPeriod` attribute, every few times new transactions will appear to be paid. For example, putting a 2 here and having monthly as `intervalPeriod`, new payments will appear every two months
  intervalEach INTEGER,

  -- Date until which payments will continue to appear. If this field or the `remainingTransactions` field is not specified, the recurring transaction will never end.
  endDate DATETIME,

  -- Number of payments remaining. This value must dicrease by one in the case a new payment is done within this rule. If this field or the `endDate` field is not specified, the recurring transaction will never end.
  remainingTransactions INTEGER,

  -- Transfer/I/E: exactly one of category vs receiving. Investment (N): asset or
  -- security set, receiving null, category null.
  CHECK (
    (type = 'N' AND (assetID IS NOT NULL OR securityID IS NOT NULL) AND receivingAccountID IS NULL AND categoryID IS NULL AND valueInDestiny IS NULL)
    OR
    (type != 'N' AND ((receivingAccountID IS NULL) != (categoryID IS NULL)))
  ),

  -- Recurrency data mandatory fields (if the transaction is required)
  CHECK ((intervalPeriod IS NULL) == (intervalEach IS NULL)),

  CHECK ((intervalPeriod IS NOT NULL) OR (endDate IS NULL)),
  CHECK ((intervalPeriod IS NOT NULL) OR (remainingTransactions IS NULL)),

  -- Location data checks:
  CHECK ((locLongitude IS NULL AND locLatitude IS NULL) OR (locLongitude IS NOT NULL AND locLatitude IS NOT NULL)),
  CHECK ((locAddress IS NULL) OR (locLatitude IS NOT NULL AND locLongitude IS NOT NULL)),

  -- valueInDestiny can not be defined for non-transfer transactions:
  CHECK (categoryID IS NULL OR valueInDestiny IS NULL)
) AS TransactionInDB;

CREATE TABLE IF NOT EXISTS tags (
    id TEXT NOT NULL PRIMARY KEY,

    -- The name of the tag
    name TEXT UNIQUE NOT NULL,

    -- The display color of the tag
    color TEXT NOT NULL,

    -- The display order when listing tag
    displayOrder INTEGER NOT NULL,

    -- The description of the tag
    description TEXT
) AS TagInDB;

CREATE TABLE IF NOT EXISTS transactionTags (
  transactionID TEXT NOT NULL REFERENCES transactions(id) ON DELETE CASCADE ON UPDATE CASCADE,
  tagID TEXT NOT NULL REFERENCES tags(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE IF NOT EXISTS transactionFilterSets (
    id TEXT NOT NULL PRIMARY KEY,

    -- JSON list of account IDs. Will be null if this filter is not in use, or if all accounts are selected
    accountsIDs TEXT MAPPED BY `const StringListTypeConverter()`, 
    
    -- JSON list of category IDs. Will be null if this filter is not in use, or if all categories are selected
    categoriesIds TEXT MAPPED BY `const StringListTypeConverter()`,

    -- JSON list of transaction statuses
    status TEXT MAPPED BY `OptEnumListTypeConverter(TransactionStatus.values)`, 

    minDate DATETIME,
    maxDate DATETIME,
    searchValue TEXT,

    -- JSON list of transaction types
    transactionTypes TEXT MAPPED BY `EnumListTypeConverter(TransactionType.values)`, 

    minValue REAL,
    maxValue REAL,

    -- JSON list of tag IDs
    tagsIDs TEXT MAPPED BY `const OptStringListTypeConverter()`
) AS TransactionFilterSetInDB;

CREATE TABLE IF NOT EXISTS savedFilters (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    
    -- The display order when listing the saved filters
    displayOrder INTEGER NOT NULL,

    filterID TEXT NOT NULL REFERENCES transactionFilterSets(id) ON DELETE CASCADE ON UPDATE CASCADE
) AS SavedFilterInDB;

CREATE TABLE IF NOT EXISTS budgets (
  id TEXT NOT NULL PRIMARY KEY,

  -- Title of the budget and its identificator. For instance, this name is unique (the user can not have another budget with the same name) 
  name TEXT NOT NULL UNIQUE,

  --  Maximum value that the budget takes. It will always be in the user's preferred currency
  limitAmount REAL NOT NULL,

  -- Periodicity of the budget. If null, the budget is a single-time budget
  intervalPeriod ENUMNAME(Periodicity) CHECK(intervalPeriod IN ('day','week','month','year')),

  -- Custom start date. Only if the budget has no periodicity
  startDate DATETIME,

  -- Custom end date. Only if the budget has no periodicity
  endDate DATETIME,

  filterID TEXT NOT NULL REFERENCES transactionFilterSets(id) ON DELETE CASCADE ON UPDATE CASCADE,

  CHECK ((startDate IS NULL AND endDate IS NULL) != (intervalPeriod IS NULL))
) AS BudgetInDB;

CREATE TABLE IF NOT EXISTS goals (
  id TEXT NOT NULL PRIMARY KEY,

  -- Title of the goal and its identificator. For instance, this name is unique (the user can not have another goal with the same name) 
  name TEXT NOT NULL UNIQUE,

  --  Target amount of the goal. It will always be in the user's preferred currency
  amount REAL NOT NULL,

  initialAmount REAL NOT NULL DEFAULT 0,

  -- Custom start date
  startDate DATETIME NOT NULL,

  -- Custom end date
  endDate DATETIME,

  type INTEGER NOT NULL CHECK(type IN (0, 1)) MAPPED BY `CustomEnumConverter(GoalType.values)`,

  filterID TEXT NOT NULL REFERENCES transactionFilterSets(id) ON DELETE CASCADE ON UPDATE CASCADE
) AS GoalInDB;


CREATE TABLE IF NOT EXISTS debts (
    id TEXT NOT NULL PRIMARY KEY,
    
    -- Debt name (unique among user debts)
    name TEXT UNIQUE NOT NULL,

    type INTEGER NOT NULL CHECK(type IN (0, 1)) MAPPED BY `CustomEnumConverter(DebtDirection.values)`,

    iconId TEXT NOT NULL,

    -- ID of the currency used by this debt. The transactions related to this debt can be in different accounts and therefore in different currencies, but they will all be converted to this currency when calculating the total amount of the debt
    currencyId TEXT NOT NULL REFERENCES currencies(code) ON DELETE CASCADE ON UPDATE CASCADE,
    
    -- Initial amount of the debt, in the currency of the debt. This amount will not be used to calculate user balances
    initialAmount REAL NOT NULL DEFAULT 0,

    -- Date on which the debt was created or the money was lent/borrowed. Before this date, no transactions can exists on it.
    startDate DATETIME NOT NULL,

    -- The closing date of the debt. After this date, no transactions can exists on it.
    endDate DATETIME
) AS DebtInDB;

CREATE TABLE IF NOT EXISTS userSettings (
  settingKey ENUMNAME(SettingKey) NOT NULL PRIMARY KEY,
  settingValue TEXT
);

CREATE TABLE IF NOT EXISTS appData (
  appDataKey ENUMNAME(AppDataKey) NOT NULL PRIMARY KEY,
  appDataValue TEXT
);