# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
.gitconfig

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Project specific
**/generated/
android/app/.cxx/

# Store screenshots: generated by scripts/generate_screenshots.bat and the store images editor.
# Only the English store images are committed, as the README shows them. Commit
# them when publishing to the stores, not after every export.
app-marketplaces/screenshots/*/Screenshots/
app-marketplaces/screenshots/*/StoreImages/
!app-marketplaces/screenshots/en/StoreImages/
